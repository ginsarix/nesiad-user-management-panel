{
  "name": "nesiad-user-management-panel",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:no-member": "psql -U cankomusdogan -d nesiad_member_management_db -c \"TRUNCATE TABLE member CASCADE;\" && pnpm dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts",
    "cron:sms": "tsx --env-file=.env src/scripts/cron-sms.ts",
    "test": "NODE_OPTIONS='--import dotenv/config' vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hono/vercel": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^7.0.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "file-type": "^22.3.0",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "nanoid": "^6.0.2",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/turbopack": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "1.0.0-rc.5",
    "read-excel-file": "9.3.14",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
