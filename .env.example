NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/nesiad_member_management_db
# openssl rand -hex 32
BETTER_AUTH_SECRET=

# The first admin: created at server start (and by pnpm db:seed) when no account has this email
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
# Turkish mobile number that gets the admin's login codes by SMS (trusted without a code). Required with the two above
DEFAULT_ADMIN_PHONE=

SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_PORT=
# SMTP_SECURE=

# Required even in dry run
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=
# Unset = dry run, nothing is sent. Set to false in production
# SMS_DRY_RUN=false

# POST /api/cron/sms (pnpm cron:sms, Plesk scheduled task). 32+ characters: openssl rand -hex 32
CRON_SECRET=

# Member logos. Defaults to ./uploads; in production an absolute path outside the deploy folder
# UPLOAD_DIR=
